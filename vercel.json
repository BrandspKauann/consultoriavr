{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": "",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/pagamento-de-folha(?:/index\\.html)?/?",
      "headers": { "Location": "https://www.gestaobeneficios.com.br/pagamento-de-folha" },
      "status": 308
    },
    {
      "src": "/content/(.*)",
      "status": 404
    },
    {
      "src": "/tools/(.*)",
      "status": 404
    },
    {
      "src": "/package(-lock)?\\.json",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/conteudo/(.*)",
      "status": 404
    }
  ]
}
