{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": "",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/content/(.*)",
      "status": 404
    },
    {
      "src": "/tools/(.*)",
      "status": 404
    },
    {
      "src": "/package(-lock)?\\.json",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/conteudo/(.*)",
      "status": 404
    }
  ]
}
